# Production OAuth configuration.
#
# In DEVELOPMENT these are IGNORED: the loopback client (http://localhost) is
# synthesized automatically from the dev origin (see src/lib/oauth/client.ts).
#
# In PRODUCTION you must host a client-metadata.json at a public HTTPS URL and
# point VITE_CLIENT_ID at it. VITE_REDIRECT_URI must be listed in that file's
# redirect_uris and must match the deployed /oauth/callback route.

# Public URL of your hosted client-metadata.json (the OAuth client_id).
VITE_CLIENT_ID=https://ovoid.example.com/client-metadata.json

# Where the PDS redirects back after authorization.
VITE_REDIRECT_URI=https://ovoid.example.com/oauth/callback

# --- Sentry (error / performance monitoring) ---
#
# The DSN is a PUBLIC client key shipped in the bundle; instrument.ts has a
# built-in default, so this is only needed to point a different environment at a
# different project.
VITE_SENTRY_DSN=
# Optional build-time tag for the Sentry "release" of each build.
VITE_APP_VERSION=

# Source-map upload (build time only — NOT shipped to the client). When
# SENTRY_AUTH_TOKEN is set the vite build uploads hidden source maps so stack
# traces de-minify in Sentry. Leave unset locally; set in CI.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Ovoid notify service (push notifications) ---
#
# Base URL of the deployed notify backend (the ./notify service in this repo)
# and its DID (NOTIFY_SERVICE_DID there). Both unset = push UI hidden.
VITE_NOTIFY_URL=
VITE_NOTIFY_DID=
