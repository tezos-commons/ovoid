# Production OAuth configuration.
#
# In DEVELOPMENT these are IGNORED: the loopback client (http://localhost) is
# synthesized automatically from the dev origin (see src/lib/oauth/client.ts).
#
# In PRODUCTION you must host a client-metadata.json at a public HTTPS URL and
# point VITE_CLIENT_ID at it. VITE_REDIRECT_URI must be listed in that file's
# redirect_uris and must match the deployed /oauth/callback route.

# Public URL of your hosted client-metadata.json (the OAuth client_id).
VITE_CLIENT_ID=https://ovoid.example.com/client-metadata.json

# Where the PDS redirects back after authorization.
VITE_REDIRECT_URI=https://ovoid.example.com/oauth/callback
